{
  "manifest_version": 3,
  "name": "Steam 玩伴探测",
  "version": "1.1",
  "key": "",
  "description": "根据 Steam 游戏时长找到合拍好友，并联动本地 Steam 匹配开黑车队",
  "permissions": ["storage", "nativeMessaging"],
  "host_permissions": [
    "https://api.steampowered.com/*",
    "https://media.steampowered.com/*",
    "https://steam.i-test.top/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_title": "Steam 好友匹配器"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://steam.i-test.top/*", "http://127.0.0.1/*", "http://localhost/*"],
      "js": ["content-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
