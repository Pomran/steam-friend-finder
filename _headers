# Cloudflare Pages headers
/data/images/*
  Cache-Control: public, max-age=31536000, immutable
/data/video/*
  Cache-Control: public, max-age=31536000, immutable
/data/text/*
  Cache-Control: public, max-age=0, must-revalidate
/*.json
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: no-cache, must-revalidate
/share.html
  Cache-Control: no-cache, must-revalidate
/script.js
  Cache-Control: no-cache, must-revalidate
/play
  Cache-Control: no-cache, must-revalidate
/play.html
  Cache-Control: no-cache, must-revalidate
/play.js
  Cache-Control: no-cache, must-revalidate
/play-sw.js
  Cache-Control: no-cache, must-revalidate
/play-manifest.json
  Cache-Control: no-cache, must-revalidate
